{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WFDiag release gate observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "status",
    "source_revision",
    "recorded_at_utc",
    "evidence",
    "blockers",
    "decision_by"
  ],
  "properties": {
    "gate_id": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "pass",
        "fail",
        "blocked"
      ]
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "cwd",
          "platform",
          "timestamp_utc",
          "exit_code",
          "log",
          "actor",
          "source_revision",
          "artifact_sha256"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "log": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "enum": [
              "codex",
              "owner",
              "independent_reviewer"
            ]
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "blockers": {
            "maxItems": 0
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          },
          "decision_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
