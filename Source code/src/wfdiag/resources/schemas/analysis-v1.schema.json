        "name",
        "addresses",
        "active_profile",
        "state",
        "source_ref"
      ],
      "title": "NetworkInterface",
      "type": "object"
    },
    "NetworkSnapshot": {
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "items": {
            "$ref": "#/$defs/NetworkInterface"
          },
          "maxItems": 512,
          "title": "Interfaces",
          "type": "array"
        },
        "observed_at_utc": {
          "format": "date-time",
          "title": "Observed At Utc",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "observed_at_utc",
