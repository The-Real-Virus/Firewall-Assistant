          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Build"
        },
        "edition": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edition"
        },
        "hostname": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "os": {
          "enum": [
            "windows",
            "linux",
            "darwin",
            "unknown"
          ],
          "title": "Os",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supported_build": {
          "title": "Supported Build",
          "type": "boolean"
        },
        "windows_product_type": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Windows Product Type"
        }
      },
      "required": [
        "os",
        "edition",
        "build",
        "architecture",
        "supported_build"
      ],
      "title": "Host",
      "type": "object"
    },
    "Intent": {
      "additionalProperties": false,
      "properties": {
        "application_identity_confirmed": {
          "title": "Application Identity Confirmed",
          "type": "boolean"
        },
        "application_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Application Path",
          "type": "string"
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ],
          "title": "Direction",
          "type": "string"
        },
        "local_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Port"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "protocol": {
          "const": "TCP",
          "title": "Protocol",
          "type": "string"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "remote_addresses": {
          "items": {
            "maxLength": 80,
            "minLength": 2,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Remote Addresses",
          "type": "array"
        },
        "remote_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remote Port"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "application_path",
        "application_identity_confirmed",
        "direction",
        "protocol",
        "profile",
        "remote_addresses",
        "local_port",
        "remote_port",
        "purpose"
      ],
      "title": "Intent",
      "type": "object"
    },
    "NetworkInterface": {
      "additionalProperties": false,
      "properties": {
        "active_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/Profile"
            },
            {
              "type": "null"
            }
          ]
        },
        "addresses": {
          "items": {
            "maxLength": 64,
            "minLength": 2,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Addresses",
          "type": "array"
        },
        "interface_index": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Interface Index",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
