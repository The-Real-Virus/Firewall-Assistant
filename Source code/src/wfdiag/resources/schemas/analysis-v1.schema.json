{
  "$defs": {
    "Category": {
      "enum": [
        "EXPLICIT_BLOCK",
        "DEFAULT_BLOCK",
        "PROFILE_MISMATCH",
        "LOCAL_RULE_MERGE_RESTRICTED",
        "UNRESOLVED_WFP_BLOCK",
        "EVIDENCE_GAP",
        "NO_RELEVANT_EVENT"
      ],
      "title": "Category",
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "inbound",
        "outbound",
        "unknown"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "application_canonical": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Application Canonical"
        },
        "application_raw": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Application Raw"
        },
        "destination_address": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Address"
        },
        "destination_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Port"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "event_id": {
          "enum": [
            5157,
            5152
          ],
          "title": "Event Id",
          "type": "integer"
        },
        "event_version": {
          "maximum": 255,
          "minimum": 0,
          "title": "Event Version",
          "type": "integer"
        },
        "filter_origin": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Filter Origin"
        },
        "filter_runtime_id": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Filter Runtime Id"
        },
        "interface_index": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interface Index"
        },
        "pid_raw": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pid Raw"
        },
        "pid_value": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pid Value"
        },
        "protocol": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protocol"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "record_id": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Record Id",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_address": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Address"
        },
        "source_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Port"
        },
        "source_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "timestamp_utc": {
          "format": "date-time",
          "title": "Timestamp Utc",
          "type": "string"
        },
        "unknown_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 50,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Unknown Fields",
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "provider",
        "record_id",
        "event_version",
        "timestamp_utc",
        "application_raw",
        "application_canonical",
        "pid_raw",
        "pid_value",
        "direction",
        "source_address",
        "source_port",
        "destination_address",
        "destination_port",
        "protocol",
        "filter_runtime_id",
        "filter_origin",
        "interface_index",
        "source_ref"
      ],
      "title": "Event",
      "type": "object"
    },
    "EvidenceGrade": {
      "enum": [
        "confirmed",
        "supported",
        "unknown"
      ],
      "title": "EvidenceGrade",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "candidate_rules": {
          "default": [],
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Candidate Rules",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/Event"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 90,
          "title": "Event Refs",
          "type": "array"
        },
        "evidence_grade": {
          "$ref": "#/$defs/EvidenceGrade"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Limitations",
          "type": "array"
        },
        "next_steps": {
          "items": {
            "$ref": "#/$defs/NextStep"
          },
          "maxItems": 20,
          "title": "Next Steps",
          "type": "array"
        },
        "observation": {
          "maxLength": 2000,
          "title": "Observation",
          "type": "string"
        },
        "policy_snapshot_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Snapshot Utc"
        },
        "proposal_eligible": {
          "title": "Proposal Eligible",
          "type": "boolean"
        },
        "refusal_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Refusal Codes",
          "type": "array"
        },
        "relevance": {
          "$ref": "#/$defs/Relevance"
        },
        "summary": {
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "evidence_grade",
        "summary",
        "observation",
        "evidence_refs",
        "policy_snapshot_utc",
        "relevance",
        "next_steps",
        "proposal_eligible"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FirewallProfile": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active"
        },
        "allow_local_rule_merge": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allow Local Rule Merge"
        },
        "default_inbound": {
          "enum": [
            "Allow",
            "Block",
            "unknown"
          ],
          "title": "Default Inbound",
          "type": "string"
        },
        "default_outbound": {
          "enum": [
            "Allow",
            "Block",
            "unknown"
          ],
          "title": "Default Outbound",
          "type": "string"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enabled"
        },
        "policy_source": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Source"
        },
        "policy_source_type": {
          "default": "unknown",
          "enum": [
            "local",
            "GPO",
            "MDM",
            "other",
            "unknown"
          ],
          "title": "Policy Source Type",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "source_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "enabled",
        "active",
        "default_inbound",
        "default_outbound",
        "allow_local_rule_merge",
        "source_ref"
      ],
      "title": "FirewallProfile",
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "enum": [
            "x64",
            "arm64",
            "x86",
            "unknown"
          ],
