          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/FailedPayload"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "sequence": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "const": "failed",
          "title": "Type",
          "type": "string"
        }
