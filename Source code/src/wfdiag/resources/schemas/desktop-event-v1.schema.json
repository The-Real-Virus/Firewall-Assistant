{
  "$defs": {
    "CancelledEvent": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[A-Za-z0-9-]{1,64}$",
          "title": "Job Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CancelledPayload"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "sequence": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "const": "cancelled",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "sequence",
        "type",
        "payload"
      ],
      "title": "CancelledEvent",
      "type": "object"
    },
    "CancelledPayload": {
      "additionalProperties": false,
      "properties": {
        "cleanup_confirmed": {
          "title": "Cleanup Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "cleanup_confirmed"
      ],
      "title": "CancelledPayload",
      "type": "object"
    },
    "CompletedEvent": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[A-Za-z0-9-]{1,64}$",
          "title": "Job Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CompletedPayload"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "sequence": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "const": "completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "sequence",
        "type",
        "payload"
      ],
      "title": "CompletedEvent",
      "type": "object"
    },
    "CompletedPayload": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "exit_code": {
          "enum": [
            0,
            5
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "output": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "output",
        "completeness",
        "exit_code"
      ],
      "title": "CompletedPayload",
      "type": "object"
    },
    "Completeness": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "FailedEvent": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[A-Za-z0-9-]{1,64}$",
