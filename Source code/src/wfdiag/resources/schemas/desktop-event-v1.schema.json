    },
    "WarningEvent": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[A-Za-z0-9-]{1,64}$",
          "title": "Job Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/WarningPayload"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "sequence": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "const": "warning",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "sequence",
        "type",
        "payload"
      ],
      "title": "WarningEvent",
      "type": "object"
    },
    "WarningPayload": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "WarningPayload",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/CancelledEvent",
      "completed": "#/$defs/CompletedEvent",
      "failed": "#/$defs/FailedEvent",
      "progress": "#/$defs/ProgressEvent",
      "started": "#/$defs/StartedEvent",
      "warning": "#/$defs/WarningEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/StartedEvent"
    },
    {
      "$ref": "#/$defs/ProgressEvent"
    },
    {
      "$ref": "#/$defs/WarningEvent"
    },
    {
      "$ref": "#/$defs/CompletedEvent"
    },
    {
      "$ref": "#/$defs/FailedEvent"
    },
    {
      "$ref": "#/$defs/CancelledEvent"
    }
  ]
