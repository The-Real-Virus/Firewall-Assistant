      ],
      "title": "FailedEvent",
      "type": "object"
    },
    "FailedPayload": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "exit_code": {
          "enum": [
            2,
            3,
            4,
            5,
            6
          ],
          "title": "Exit Code",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "exit_code"
      ],
      "title": "FailedPayload",
      "type": "object"
    },
    "ProgressEvent": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[A-Za-z0-9-]{1,64}$",
          "title": "Job Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ProgressPayload"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "sequence": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "const": "progress",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "sequence",
        "type",
        "payload"
      ],
      "title": "ProgressEvent",
      "type": "object"
    },
    "ProgressPayload": {
      "additionalProperties": false,
      "properties": {
        "completed_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed Units"
        },
        "stage": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "total_units": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Units"
        }
      },
      "required": [
        "stage"
      ],
      "title": "ProgressPayload",
      "type": "object"
    },
    "StartedEvent": {
